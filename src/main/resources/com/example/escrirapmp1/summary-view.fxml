<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="25"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.escrirapmp1.controller.SummaryController"
      style="-fx-background-color: linear-gradient(#667eea 0%, #764ba2 100%);">

   <children>
      <Label text="🎉 ¡Juego Completado!" textFill="white" style="-fx-font-weight: bold;">
         <font>
            <Font size="36.0" />
         </font>
         <VBox.margin>
            <Insets bottom="20.0" />
         </VBox.margin>
      </Label>

      <Label fx:id="finalLevelLabel" text="Nivel alcanzado: 0" textFill="white" style="-fx-font-size: 20;">
         <font>
            <Font size="24.0" />
         </font>
      </Label>

      <Label fx:id="streakLabel" text="Puntaje total: 0" textFill="white" style="-fx-font-size: 20;">
         <font>
            <Font size="24.0" />
         </font>
      </Label>

      <Label fx:id="timeLabel" text="Tiempo restante: 0s" textFill="white" style="-fx-font-size: 20;">
         <font>
            <Font size="24.0" />
         </font>
      </Label>

      <Button fx:id="restartButton" onAction="#restartGame" text="🔄 Jugar de Nuevo" prefHeight="60.0" prefWidth="300.0"
              style="-fx-background-color: linear-gradient(#7b3fe4, #5a2ccf); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18; -fx-background-radius: 25;">
         <font>
            <Font size="20.0" />
         </font>
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
      </Button>
   </children>
</VBox>

